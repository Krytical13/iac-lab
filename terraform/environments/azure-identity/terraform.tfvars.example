# Copy to terraform.tfvars and put in your own values. Git ignores terraform.tfvars.

# From: az account show --query id --output tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# The one repository whose workflows may sign in as the identity. Write it the
# way GitHub shows it: owner/name.
github_repository = "octo-org/octo-repo"

# Optional. Defaults shown.
# resource_group_name = "rg-iac-lab"
# identity_name       = "id-iac-lab-pipeline"
# github_environment  = "azure-lab"
