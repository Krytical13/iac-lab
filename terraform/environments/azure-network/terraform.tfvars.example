# Copy to terraform.tfvars and put in your own values. Git ignores terraform.tfvars.

# From: az account show --query id --output tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# From: az provider show --namespace Microsoft.Network --query registrationState --output tsv
# NotRegistered -> true. Registered -> false.
register_network_provider = true

# Optional. Defaults shown.
# resource_group_name = "rg-iac-lab"
# vnet_name           = "vnet-iac-lab"
# address_space       = "10.20.0.0/16"
# data_port           = 5432
