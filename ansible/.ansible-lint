---
# ansible-lint configuration. "moderate" is the profile a team project should
# pass; "production" adds metadata and naming rules worth reading about once
# the roles are stable.
profile: moderate

exclude_paths:
  - galaxy_roles/     # third-party roles are linted by their authors
  - .ansible/
  # Written by the Vault guide (Module 04) with your SSH CA public key on one
  # 700-character line; gitignored, and not something to hand-format.
  - inventories/hyperv-lab/group_vars/linux/ssh_ca.yml

skip_list:
  # admin_user, admin_ssh_keys, extra_firewall_rules, sysctl_settings,
  # chrony_ntp_servers are deliberately shared across roles and inventories
  # (snmpd reads admin_user, group_vars set the firewall lists), so they do not
  # carry the base_ prefix the rule asks for. Role-private names do.
  - var-naming[no-role-prefix]
