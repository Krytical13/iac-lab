# {{ ansible_managed }}
# SNMP configuration — deployed by Ansible snmpd role

# Listen on all interfaces
agentaddress udp:161

# Read-only community string (from vault)
rocommunity {{ vault_snmpd_community }} {{ snmpd_allowed_network }}

# System information
sysLocation    Server Room
sysContact     {{ admin_user }}@{{ ansible_domain | default('localhost') }}

# Restrict views
view systemonly included .1.3.6.1.2.1.1
view systemonly included .1.3.6.1.2.1.25.1