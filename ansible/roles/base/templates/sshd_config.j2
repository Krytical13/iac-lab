# {{ ansible_managed }}
# SSH hardening configuration — deployed by the Ansible base role.
# This file replaces the distribution's sshd_config, including its
# "Include /etc/ssh/sshd_config.d/*.conf" line, so drop-ins no longer apply.

Port 22
AddressFamily any

# Authentication
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
UsePAM yes

# Allowed users
AllowUsers {{ admin_user }}

# Security
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
MaxAuthTries 3
MaxSessions 3
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2

{% if ssh_trusted_user_ca_keys | length > 0 or ssh_host_certificate %}
# Vault SSH CA (Vault guide, Module 04)
{% if ssh_trusted_user_ca_keys | length > 0 %}
TrustedUserCAKeys /etc/ssh/trusted-user-ca-keys.pem
{% endif %}
{% if ssh_host_certificate %}
HostCertificate {{ ssh_host_certificate }}
{% endif %}

{% endif %}
# Logging
LogLevel VERBOSE
SyslogFacility AUTH

# SFTP
Subsystem sftp {{ base_sftp_server }}
