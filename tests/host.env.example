# tests/host.env.example — copy to tests/host.env (gitignored) and fill in your host.
# Used only by the tests/host-*.sh checks; Terraform reads terraform.tfvars instead.
HOST=hyperv-host                 # IP or DNS name of the Hyper-V host
SSH_USER=admin                   # account with admin rights and OpenSSH access on the host
SSH_KEY=~/.ssh/id_ed25519        # key for that account
NIC="Ethernet"                   # physical adapter the External switch binds to (Get-NetAdapter)
EXPECT_MAC=00-11-22-33-44-55     # that adapter's MAC: must survive the switch creation
EXPECT_IP=192.168.1.20           # the host's IPv4 address: must survive the switch creation
IMAGE_ROOT='C:\HyperV'           # same value you gave setup-winrm.ps1 -ImageRoot
LAN_PREFIX=192.168.1.            # the VMs' DHCP addresses start with this
